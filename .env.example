# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram user_id администраторов через запятую (доступ к /collect и /stats)
ADMIN_IDS=

# База данных. По умолчанию SQLite в ./data
DATABASE_URL=sqlite+aiosqlite:///data/events.db

# Публичные Telegram-каналы с анонсами: имя_канала:Организатор через запятую
TG_CHANNELS=Yandex4Developers:Яндекс

# Timepad API. Токен можно получить на dev.timepad.ru (без него запросы могут отклоняться)
TIMEPAD_ENABLED=true
TIMEPAD_TOKEN=
TIMEPAD_CITIES=Санкт-Петербург,Москва
# ID категорий через запятую. Пусто = найти категорию «ИТ» автоматически через справочник
TIMEPAD_CATEGORY_IDS=

# Как часто собирать события (часы) и во сколько слать дайджесты (по Москве)
COLLECT_INTERVAL_HOURS=6
DIGEST_HOUR=10

TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
